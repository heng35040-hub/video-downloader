# 登录凭证与隐私 —— 绝对不能上传
# 用通配而不是逐个列：新增一个平台（比如 profile_bili）忘了加就出事。
# 实测踩过一次：profile_bili 被 git add -A 整个暂存进去，里面是完整的
# 浏览器配置目录（cookies、passport 的 IndexedDB、Local Storage）。
profile_*/
cookies/

# 运行产物
logs/
__pycache__/
*.pyc
*.part
dist/
build/
.pytest_cache/

# 一键下载的工具（源码运行时就在项目目录下）。
# ffmpeg.exe / yt-dlp.exe 各上百 MB，绝不能进仓库
tools/

# 打包产物（CI 生成，不入库）
VideoDownloader-win64.zip
SHA256SUMS.txt

# 任何 exe 都不该进仓库：tools/ 兜得住运行时下载的 ffmpeg/yt-dlp，
# 但根目录误放一个（比如把构建产物拷进来）就会被 git add . 跟踪
*.exe

# 本机个性化
*.lnk
settings.json
settings.json.tmp
video-downloader/
